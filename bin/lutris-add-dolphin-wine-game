#!/usr/bin/env python3
import configparser
import io
import os
import shutil
import subprocess
import sys
import struct
from pathlib import Path

try:
    import pefile
    from PIL import Image, ImageDraw, ImageFilter, ImageFont
except ImportError:
    pefile = None
    Image = None
    ImageDraw = None
    ImageFilter = None
    ImageFont = None


RUNNER = "wine"
GENERIC_DIR_NAMES = {
    "bin",
    "binaries",
    "binary",
    "client",
    "data",
    "game",
    "games",
    "launcher",
    "retail",
    "win64",
    "win32",
    "x64",
    "x86",
    "_retail_",
}


def get_config_file():
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "lutris-dolphin-wine-game" / "config.ini"


def get_wine_prefix():
    if os.environ.get("LUTRIS_DOLPHIN_WINE_PREFIX"):
        return os.environ["LUTRIS_DOLPHIN_WINE_PREFIX"]

    config_file = get_config_file()
    parser = configparser.ConfigParser()
    parser.read(config_file)
    configured_prefix = parser.get("settings", "wine_prefix", fallback="")
    return os.path.expanduser(configured_prefix or "~/AAA")


WINE_PREFIX = get_wine_prefix()


def get_icon_dir():
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
    return data_home / "icons" / "hicolor" / "128x128" / "apps"


def notify(title, message):
    if os.environ.get("LUTRIS_DOLPHIN_NO_NOTIFY") == "1":
        return

    commands = (
        ("kdialog", ["kdialog", "--title", title, "--passivepopup", message, "6"]),
        ("notify-send", ["notify-send", title, message]),
    )
    for binary, command in commands:
        if shutil.which(binary):
            subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return


def normalize_path(path):
    return os.path.normcase(os.path.realpath(os.path.expanduser(str(path))))


def get_game_name(path):
    parts = path.resolve().parts
    for index in range(len(parts) - 2, -1, -1):
        if parts[index].casefold() == "games" and index + 1 < len(parts) - 1:
            return parts[index + 1]

    directory = path.parent
    while directory.name and directory.name.casefold() in GENERIC_DIR_NAMES:
        if directory.parent == directory:
            break
        directory = directory.parent

    return directory.name or path.parent.name or path.stem


def validate_selected_path(selected_path):
    path = Path(selected_path).expanduser()
    if not path.exists():
        raise FileNotFoundError(f"檔案不存在：{selected_path}")
    if path.is_dir():
        raise IsADirectoryError(f"請在遊戲執行檔上按右鍵，不是資料夾：{selected_path}")
    return path


def load_font(size):
    if ImageFont is None:
        return None

    for font_path in (
        "/usr/share/fonts/TTF/DejaVuSans-Bold.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    ):
        try:
            return ImageFont.truetype(font_path, size)
        except OSError:
            pass
    return ImageFont.load_default()


def dib_to_rgba(data):
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        return Image.open(io.BytesIO(data)).convert("RGBA")
    if len(data) < 40:
        raise ValueError("DIB too short")

    header_size = struct.unpack_from("<I", data, 0)[0]
    if header_size < 40 or len(data) < header_size:
        raise ValueError(f"unsupported DIB header: {header_size}")

    width, stored_height, _planes, bit_count, compression, _image_size = struct.unpack_from(
        "<iiHHII", data, 4
    )
    if width <= 0 or stored_height == 0:
        raise ValueError("invalid DIB dimensions")

    height = abs(stored_height) // 2 if abs(stored_height) >= 2 else abs(stored_height)
    top_down = stored_height < 0
    offset = header_size

    palette = None
    if bit_count <= 8:
        colors_used = struct.unpack_from("<I", data, 32)[0] if len(data) >= 36 else 0
        palette_count = colors_used or (1 << bit_count)
        palette = []
        for index in range(palette_count):
            b, g, r, _a = struct.unpack_from("<BBBB", data, offset + index * 4)
            palette.append((r, g, b, 255))
        offset += palette_count * 4

    if compression not in (0, 3):
        raise ValueError(f"unsupported DIB compression: {compression}")

    if bit_count == 32:
        stride = width * 4
    elif bit_count == 24:
        stride = ((width * 3 + 3) // 4) * 4
    elif bit_count == 8:
        stride = ((width + 3) // 4) * 4
    elif bit_count == 4:
        stride = (((width + 1) // 2 + 3) // 4) * 4
    elif bit_count == 1:
        stride = (((width + 7) // 8 + 3) // 4) * 4
    else:
        raise ValueError(f"unsupported DIB bit count: {bit_count}")

    pixels = bytearray(width * height * 4)
    for y in range(height):
        src_y = y if top_down else (height - 1 - y)
        row = data[offset + src_y * stride : offset + src_y * stride + stride]
        for x in range(width):
            if bit_count == 32:
                b, g, r, a = row[x * 4 : x * 4 + 4]
            elif bit_count == 24:
                b, g, r = row[x * 3 : x * 3 + 3]
                a = 255
            elif bit_count == 8:
                r, g, b, a = palette[row[x]]
            elif bit_count == 4:
                value = row[x // 2]
                palette_index = (value >> 4) if x % 2 == 0 else (value & 15)
                r, g, b, a = palette[palette_index]
            else:
                value = row[x // 8]
                palette_index = (value >> (7 - (x % 8))) & 1
                r, g, b, a = palette[palette_index]

            index = (y * width + x) * 4
            pixels[index : index + 4] = bytes((r, g, b, a))

    mask_offset = offset + stride * height
    mask_stride = ((width + 31) // 32) * 4
    if mask_offset + mask_stride * height <= len(data):
        for y in range(height):
            src_y = y if top_down else (height - 1 - y)
            row = data[mask_offset + src_y * mask_stride : mask_offset + src_y * mask_stride + mask_stride]
            for x in range(width):
                if row[x // 8] & (0x80 >> (x % 8)):
                    pixels[(y * width + x) * 4 + 3] = 0

    return Image.frombytes("RGBA", (width, height), bytes(pixels))


def extract_best_icon_image(exe_path):
    if pefile is None or Image is None:
        return None

    pe = pefile.PE(str(exe_path), fast_load=True)
    pe.parse_data_directories(
        directories=[pefile.DIRECTORY_ENTRY["IMAGE_DIRECTORY_ENTRY_RESOURCE"]]
    )

    icon_blobs = {}
    group_blobs = []
    root = getattr(pe, "DIRECTORY_ENTRY_RESOURCE", None)
    if not root:
        return None

    for res_type in root.entries:
        resource_type = res_type.id if res_type.name is None else str(res_type.name)
        if resource_type not in (3, 14):
            continue

        for resource_id_entry in res_type.directory.entries:
            resource_id = (
                resource_id_entry.id
                if resource_id_entry.name is None
                else str(resource_id_entry.name)
            )
            if not hasattr(resource_id_entry, "directory"):
                continue

            for lang_entry in resource_id_entry.directory.entries:
                data = pe.get_data(
                    lang_entry.data.struct.OffsetToData,
                    lang_entry.data.struct.Size,
                )
                if resource_type == 3:
                    icon_blobs[resource_id] = data
                else:
                    group_blobs.append(data)
                break

    candidates = []
    for group in group_blobs:
        if len(group) < 6:
            continue

        _reserved, icon_type, count = struct.unpack_from("<HHH", group, 0)
        if icon_type != 1:
            continue

        offset = 6
        for _index in range(count):
            if offset + 14 > len(group):
                break
            width, height, _colors, _reserved_b, _planes, bpp, size, resource_id = struct.unpack_from(
                "<BBBBHHIH", group, offset
            )
            offset += 14
            if resource_id not in icon_blobs:
                continue

            decoded_width = 256 if width == 0 else width
            decoded_height = 256 if height == 0 else height
            candidates.append(((decoded_width * decoded_height, bpp, size), icon_blobs[resource_id]))

    for _score, data in sorted(candidates, key=lambda candidate: candidate[0], reverse=True):
        try:
            return dib_to_rgba(data)
        except Exception:
            continue
    return None


def fit_icon(icon, box):
    resized = icon.copy()
    resized.thumbnail(box, Image.Resampling.LANCZOS)
    return resized


def draw_centered_text(draw, text, font, box, fill):
    words = text.replace(".", " ").replace("-", " ").split()
    lines = []
    current = ""
    max_width = box[2] - box[0]

    for word in words:
        trial = word if not current else f"{current} {word}"
        if draw.textbbox((0, 0), trial, font=font)[2] <= max_width:
            current = trial
        else:
            if current:
                lines.append(current)
            current = word
    if current:
        lines.append(current)

    lines = lines[:3]
    heights = [draw.textbbox((0, 0), line, font=font)[3] for line in lines]
    total_height = sum(heights) + max(0, len(lines) - 1) * 4
    y = box[1] + ((box[3] - box[1]) - total_height) // 2

    for line, line_height in zip(lines, heights):
        bounds = draw.textbbox((0, 0), line, font=font)
        x = box[0] + (max_width - (bounds[2] - bounds[0])) // 2
        draw.text((x, y), line, font=font, fill=fill)
        y += line_height + 4


def make_cover(icon, game_name):
    width, height = 264, 352
    base = Image.new("RGB", (width, height), (20, 24, 28)).convert("RGBA")
    background = fit_icon(icon, (width, width)).convert("RGBA")
    background = background.resize((width, width), Image.Resampling.LANCZOS)
    background = background.filter(ImageFilter.GaussianBlur(14))
    base.alpha_composite(background, (0, 42))
    base.alpha_composite(Image.new("RGBA", (width, height), (8, 10, 12, 205)))

    logo = fit_icon(icon, (136, 136))
    x = (width - logo.width) // 2
    y = 62 + (136 - logo.height) // 2
    shadow = Image.new("RGBA", (logo.width + 20, logo.height + 20), (0, 0, 0, 0))
    shadow.alpha_composite(logo, (10, 10))
    shadow = shadow.filter(ImageFilter.GaussianBlur(10))
    base.alpha_composite(shadow, (x - 10, y - 10))
    base.alpha_composite(logo, (x, y))

    draw = ImageDraw.Draw(base)
    draw_centered_text(
        draw,
        game_name,
        load_font(19),
        (20, 224, width - 20, 314),
        (245, 245, 242, 255),
    )
    return base.convert("RGB")


def make_banner(icon, game_name):
    width, height = 184, 69
    base = Image.new("RGB", (width, height), (18, 22, 25)).convert("RGBA")
    background = fit_icon(icon, (width, width)).resize((width, width), Image.Resampling.LANCZOS)
    background = background.filter(ImageFilter.GaussianBlur(10))
    base.alpha_composite(background, (-18, -56))
    base.alpha_composite(Image.new("RGBA", (width, height), (5, 8, 12, 185)))

    logo = fit_icon(icon, (42, 42))
    base.alpha_composite(logo, (10, (height - logo.height) // 2))

    title = game_name.replace(".", " ").replace("-", " ")
    if len(title) > 24:
        title = title[:23].rstrip() + "..."

    draw = ImageDraw.Draw(base)
    draw.text((60, 25), title, font=load_font(12), fill=(248, 248, 244, 255))
    return base.convert("RGB")


def ensure_lutris_media(settings, exe_path, slug, game_name):
    if pefile is None or Image is None:
        return 0

    cover_dir = Path(settings.CONFIG_DIR) / "coverart"
    banner_dir = Path(settings.CONFIG_DIR) / "banners"
    icon_dir = get_icon_dir()
    cover_path = cover_dir / f"{slug}.jpg"
    banner_path = banner_dir / f"{slug}.jpg"
    icon_path = icon_dir / f"lutris_{slug}.png"

    need_cover = not cover_path.exists()
    need_banner = not banner_path.exists()
    need_icon = not icon_path.exists()
    if not (need_cover or need_banner or need_icon):
        return 0

    try:
        icon = extract_best_icon_image(exe_path)
        if icon is None:
            return 0

        cover_dir.mkdir(parents=True, exist_ok=True)
        banner_dir.mkdir(parents=True, exist_ok=True)
        icon_dir.mkdir(parents=True, exist_ok=True)

        created = 0
        if need_icon:
            small_icon = fit_icon(icon, (128, 128))
            canvas = Image.new("RGBA", (128, 128), (0, 0, 0, 0))
            canvas.alpha_composite(
                small_icon,
                ((128 - small_icon.width) // 2, (128 - small_icon.height) // 2),
            )
            canvas.save(icon_path)
            created += 1

        if need_cover:
            make_cover(icon, game_name).save(cover_path, quality=92)
            created += 1

        if need_banner:
            make_banner(icon, game_name).save(banner_path, quality=92)
            created += 1

        return created
    except Exception:
        return 0


def refresh_icon_cache():
    icon_root = get_icon_dir().parents[1]
    if shutil.which("gtk-update-icon-cache") and icon_root.exists():
        subprocess.Popen(
            ["gtk-update-icon-cache", "-f", "-t", str(icon_root)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def read_game_exe(settings, read_yaml_from_file, config_id):
    if not config_id:
        return None

    config_path = os.path.join(settings.GAME_CONFIG_DIR, f"{config_id}.yml")
    config = read_yaml_from_file(config_path)
    game_config = config.get("game") or {}
    exe = game_config.get("exe")
    return str(exe) if exe else None


def find_existing_game(settings, games_db, read_yaml_from_file, slug, exe_path):
    exact_match = None
    reusable_uninstalled = None
    installed_same_slug = None

    for row in games_db.get_games_by_slug(slug):
        existing_exe = read_game_exe(settings, read_yaml_from_file, row.get("configpath"))
        if existing_exe and normalize_path(existing_exe) == normalize_path(exe_path):
            exact_match = row
            break

        runner = row.get("runner") or ""
        service = row.get("service") or ""
        if row.get("installed") and runner == RUNNER and not service and installed_same_slug is None:
            installed_same_slug = row
        elif not row.get("installed") and (not runner or runner == RUNNER) and not service:
            if reusable_uninstalled is None:
                reusable_uninstalled = row

    if exact_match:
        return exact_match
    if reusable_uninstalled:
        return reusable_uninstalled
    if installed_same_slug:
        return installed_same_slug
    return None


def make_lutris_config(LutrisConfig, config_id, exe_path):
    config = LutrisConfig(runner_slug=RUNNER, game_config_id=config_id, level="game")
    config.game_level = {
        "game": {
            "exe": exe_path,
            "prefix": WINE_PREFIX,
        },
        RUNNER: {},
        "system": {},
    }
    config.update_cascaded_config()
    config.update_raw_config()
    return config


def add_from_path(selected_path):
    path = validate_selected_path(selected_path)
    exe_path = os.path.abspath(str(path))
    game_name = get_game_name(path)

    from lutris import settings
    from lutris.config import LutrisConfig, make_game_config_id
    from lutris.database import games as games_db
    from lutris.database.schema import syncdb
    from lutris.game import Game
    from lutris.util.strings import slugify
    from lutris.util.yaml import read_yaml_from_file

    os.makedirs(os.path.dirname(settings.DB_PATH), exist_ok=True)
    os.makedirs(settings.CONFIG_DIR, exist_ok=True)
    os.makedirs(settings.GAME_CONFIG_DIR, exist_ok=True)
    syncdb()

    slug = slugify(game_name)
    existing_game = find_existing_game(settings, games_db, read_yaml_from_file, slug, exe_path)

    if existing_game and existing_game.get("installed"):
        media_count = ensure_lutris_media(settings, exe_path, slug, game_name)
        return existing_game["id"], game_name, "exists", media_count

    if existing_game:
        game = Game(str(existing_game["id"]))
        action = "updated"
    else:
        game = Game()
        action = "added"

    config_id = make_game_config_id(slug)
    config = make_lutris_config(LutrisConfig, config_id, exe_path)

    game.name = game_name
    game.sortname = ""
    game.slug = slug
    game.runner_name = RUNNER
    game.directory = ""
    game.service = None
    game.appid = None
    game.is_installed = True
    game.config = config
    game.save()

    media_count = ensure_lutris_media(settings, exe_path, slug, game_name)
    return game.id, game_name, action, media_count


def main(argv):
    if not argv:
        notify("Lutris", "沒有收到檔案路徑")
        return 1

    added = []
    failed = []
    for selected_path in argv:
        try:
            added.append(add_from_path(selected_path))
        except Exception as error:
            failed.append(str(error))

    if added and not failed:
        names = ", ".join(name for _, name, _, _ in added)
        added_count = sum(1 for _, _, action, _ in added if action == "added")
        updated_count = sum(1 for _, _, action, _ in added if action == "updated")
        exists_count = sum(1 for _, _, action, _ in added if action == "exists")
        media_count = sum(media for _, _, _, media in added)
        parts = []
        if added_count:
            parts.append(f"新增 {added_count}")
        if updated_count:
            parts.append(f"更新 {updated_count}")
        if exists_count:
            parts.append(f"已存在 {exists_count}")
        if media_count:
            parts.append(f"補圖 {media_count}")
            refresh_icon_cache()
        notify("Lutris", f"已處理 Wine 遊戲（{', '.join(parts)}）：{names}")
        return 0

    if added and failed:
        names = ", ".join(name for _, name, _, _ in added)
        if sum(media for _, _, _, media in added):
            refresh_icon_cache()
        notify("Lutris", f"已處理：{names}\n失敗：{'; '.join(failed)}")
        return 2

    notify("Lutris", "新增失敗：" + "; ".join(failed))
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
