#!/usr/bin/env python3
import configparser
import os
import shutil
import subprocess
import sys
from pathlib import Path


RUNNER = "wine"
GENERIC_DIR_NAMES = {
    "bin",
    "binaries",
    "binary",
    "client",
    "data",
    "game",
    "games",
    "launcher",
    "retail",
    "win64",
    "win32",
    "x64",
    "x86",
    "_retail_",
}


def get_config_file():
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "lutris-dolphin-wine-game" / "config.ini"


def get_wine_prefix():
    if os.environ.get("LUTRIS_DOLPHIN_WINE_PREFIX"):
        return os.environ["LUTRIS_DOLPHIN_WINE_PREFIX"]

    config_file = get_config_file()
    parser = configparser.ConfigParser()
    parser.read(config_file)
    configured_prefix = parser.get("settings", "wine_prefix", fallback="")
    return os.path.expanduser(configured_prefix or "~/AAA")


WINE_PREFIX = get_wine_prefix()


def notify(title, message):
    if os.environ.get("LUTRIS_DOLPHIN_NO_NOTIFY") == "1":
        return

    commands = (
        ("kdialog", ["kdialog", "--title", title, "--passivepopup", message, "6"]),
        ("notify-send", ["notify-send", title, message]),
    )
    for binary, command in commands:
        if shutil.which(binary):
            subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return


def normalize_path(path):
    return os.path.normcase(os.path.realpath(os.path.expanduser(str(path))))


def get_game_name(path):
    parts = path.resolve().parts
    for index in range(len(parts) - 2, -1, -1):
        if parts[index].casefold() == "games" and index + 1 < len(parts) - 1:
            return parts[index + 1]

    directory = path.parent
    while directory.name and directory.name.casefold() in GENERIC_DIR_NAMES:
        if directory.parent == directory:
            break
        directory = directory.parent

    return directory.name or path.parent.name or path.stem


def validate_selected_path(selected_path):
    path = Path(selected_path).expanduser()
    if not path.exists():
        raise FileNotFoundError(f"檔案不存在：{selected_path}")
    if path.is_dir():
        raise IsADirectoryError(f"請在遊戲執行檔上按右鍵，不是資料夾：{selected_path}")
    return path


def read_game_exe(settings, read_yaml_from_file, config_id):
    if not config_id:
        return None

    config_path = os.path.join(settings.GAME_CONFIG_DIR, f"{config_id}.yml")
    config = read_yaml_from_file(config_path)
    game_config = config.get("game") or {}
    exe = game_config.get("exe")
    return str(exe) if exe else None


def find_existing_game(settings, games_db, read_yaml_from_file, slug, exe_path):
    exact_match = None
    reusable_uninstalled = None
    installed_same_slug = None

    for row in games_db.get_games_by_slug(slug):
        existing_exe = read_game_exe(settings, read_yaml_from_file, row.get("configpath"))
        if existing_exe and normalize_path(existing_exe) == normalize_path(exe_path):
            exact_match = row
            break

        runner = row.get("runner") or ""
        service = row.get("service") or ""
        if row.get("installed") and runner == RUNNER and not service and installed_same_slug is None:
            installed_same_slug = row
        elif not row.get("installed") and (not runner or runner == RUNNER) and not service:
            if reusable_uninstalled is None:
                reusable_uninstalled = row

    if exact_match:
        return exact_match
    if reusable_uninstalled:
        return reusable_uninstalled
    if installed_same_slug:
        return installed_same_slug
    return None


def make_lutris_config(LutrisConfig, config_id, exe_path):
    config = LutrisConfig(runner_slug=RUNNER, game_config_id=config_id, level="game")
    config.game_level = {
        "game": {
            "exe": exe_path,
            "prefix": WINE_PREFIX,
        },
        RUNNER: {},
        "system": {},
    }
    config.update_cascaded_config()
    config.update_raw_config()
    return config


def add_from_path(selected_path):
    path = validate_selected_path(selected_path)
    exe_path = os.path.abspath(str(path))
    game_name = get_game_name(path)

    from lutris import settings
    from lutris.config import LutrisConfig, make_game_config_id
    from lutris.database import games as games_db
    from lutris.database.schema import syncdb
    from lutris.game import Game
    from lutris.util.strings import slugify
    from lutris.util.yaml import read_yaml_from_file

    os.makedirs(os.path.dirname(settings.DB_PATH), exist_ok=True)
    os.makedirs(settings.CONFIG_DIR, exist_ok=True)
    os.makedirs(settings.GAME_CONFIG_DIR, exist_ok=True)
    syncdb()

    slug = slugify(game_name)
    existing_game = find_existing_game(settings, games_db, read_yaml_from_file, slug, exe_path)

    if existing_game and existing_game.get("installed"):
        return existing_game["id"], game_name, "exists"

    if existing_game:
        game = Game(str(existing_game["id"]))
        action = "updated"
    else:
        game = Game()
        action = "added"

    config_id = make_game_config_id(slug)
    config = make_lutris_config(LutrisConfig, config_id, exe_path)

    game.name = game_name
    game.sortname = ""
    game.slug = slug
    game.runner_name = RUNNER
    game.directory = ""
    game.service = None
    game.appid = None
    game.is_installed = True
    game.config = config
    game.save()

    return game.id, game_name, action


def main(argv):
    if not argv:
        notify("Lutris", "沒有收到檔案路徑")
        return 1

    added = []
    failed = []
    for selected_path in argv:
        try:
            added.append(add_from_path(selected_path))
        except Exception as error:
            failed.append(str(error))

    if added and not failed:
        names = ", ".join(name for _, name, _ in added)
        added_count = sum(1 for _, _, action in added if action == "added")
        updated_count = sum(1 for _, _, action in added if action == "updated")
        exists_count = sum(1 for _, _, action in added if action == "exists")
        parts = []
        if added_count:
            parts.append(f"新增 {added_count}")
        if updated_count:
            parts.append(f"更新 {updated_count}")
        if exists_count:
            parts.append(f"已存在 {exists_count}")
        notify("Lutris", f"已處理 Wine 遊戲（{', '.join(parts)}）：{names}")
        return 0

    if added and failed:
        names = ", ".join(name for _, name, _ in added)
        notify("Lutris", f"已處理：{names}\n失敗：{'; '.join(failed)}")
        return 2

    notify("Lutris", "新增失敗：" + "; ".join(failed))
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
